// DiskSweep - recursos (icono + informacion de version)
1 ICON "assets/logo.ico"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName", "DiskSweep"
      VALUE "FileDescription", "DiskSweep - Liberador de espacio en disco para Windows"
      VALUE "FileVersion", "2.0.0"
      VALUE "ProductVersion", "2.0.0"
      VALUE "OriginalFilename", "DiskSweep.exe"
      VALUE "LegalCopyright", "MIT - MR-Rodolfo"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
